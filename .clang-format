# Generated from the embedded coding rules; edit the document's tool profile.
# Normative-Version: 1.0.2
# Normative-Source: 1.编程规范/嵌入式编程规则手册.md
# Normative-SHA256: 1a5850836ecc30497f63ccaea6e0992185a9768df3542f9732bd3bb21dfb6167
# Binding-Manifest: 1.编程规范/编程规则版本绑定.json
# clang-format baseline: 21.1.0
# Allman blocks are expressed as Custom to also wrap do/while.
# Scope: owned .c/.h files; use 1.编程规范/维护工具/coding_rules.py format-check.
# Rule mappings and supplemental checks: spec section 19.4.
---
BasedOnStyle: "LLVM"
IndentWidth: 4
ContinuationIndentWidth: 4
TabWidth: 4
UseTab: "Never"
IndentCaseLabels: false
IndentCaseBlocks: false
IndentPPDirectives: "None"
IndentExternBlock: "NoIndent"
BreakBeforeBraces: "Custom"
BraceWrapping:
  AfterCaseLabel: true
  AfterClass: true
  AfterControlStatement: "Always"
  AfterEnum: true
  AfterExternBlock: true
  AfterFunction: true
  AfterNamespace: true
  AfterStruct: true
  AfterUnion: true
  BeforeElse: true
  BeforeWhile: true
  IndentBraces: false
  SplitEmptyFunction: true
  SplitEmptyRecord: true
  SplitEmptyNamespace: true
AllowShortBlocksOnASingleLine: "Never"
AllowShortFunctionsOnASingleLine: "None"
AllowShortIfStatementsOnASingleLine: "Never"
AllowShortLoopsOnASingleLine: false
AllowShortEnumsOnASingleLine: false
AllowShortCaseLabelsOnASingleLine: false
ColumnLimit: 100
AlignAfterOpenBracket: "DontAlign"
AlignOperands: "DontAlign"
BreakBeforeBinaryOperators: "All"
BreakBeforeTernaryOperators: true
BinPackArguments: false
BinPackParameters: "OnePerLine"
BinPackLongBracedList: false
AllowAllArgumentsOnNextLine: false
AllowAllParametersOfDeclarationOnNextLine: false
Cpp11BracedListStyle: true
BracedInitializerIndentWidth: 4
PointerAlignment: "Right"
DerivePointerAlignment: false
SpaceAroundPointerQualifiers: "Default"
AlignArrayOfStructures: "None"
AlignConsecutiveAssignments: "None"
AlignConsecutiveDeclarations: "None"
AlignConsecutiveMacros: "None"
AlignConsecutiveBitFields: "None"
AlignEscapedNewlines: "DontAlign"
AlignTrailingComments:
  Kind: "Never"
SpaceBeforeParens: "ControlStatements"
SpaceBeforeAssignmentOperators: true
SpaceAfterCStyleCast: true
SpaceAfterLogicalNot: false
SpacesInParens: "Never"
SpacesInSquareBrackets: false
SpacesBeforeTrailingComments: 1
MaxEmptyLinesToKeep: 1
KeepEmptyLines:
  AtStartOfFile: false
  AtStartOfBlock: false
  AtEndOfFile: false
SeparateDefinitionBlocks: "Always"
IncludeBlocks: "Preserve"
IncludeCategories:
  - {"Regex": "^<", "Priority": 1, "CaseSensitive": true}
  - {"Regex": ".*", "Priority": 2, "CaseSensitive": true}
IncludeIsMainRegex: "$"
SortIncludes:
  Enabled: true
  IgnoreCase: false
ReflowComments: "Never"
BreakStringLiterals: false
QualifierAlignment: "Leave"
InsertBraces: false
RemoveBracesLLVM: false
SkipMacroDefinitionBody: false
LineEnding: "LF"
InsertNewlineAtEOF: true
